# Control plane API
PORT=4000
NAMESPACE=opspilot
CLUSTER_ID=kind-opspilot
CORS_ORIGIN=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Kubernetes (optional — defaults to kubeconfig / in-cluster)
# KUBECONFIG=/path/to/kubeconfig

DATABASE_URL=postgres://opspilot:opspilot@localhost:5432/opspilot
REDIS_URL=redis://localhost:6379
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
LOG_LEVEL=info
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# LangGraph agent (make agent-dev). Defaults to local Ollama.
# AGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# AGENT_LLM_MODEL=qwen2.5:1.5b
# AGENT_LLM_API_KEY=ollama
