# OpsPilot incident simulation — edit these and re-run:
#   make sim
#   make sim-reset
#
# SCENARIO: crashloop | imagepull | kill | scale | telemetry | all

SCENARIO=crashloop

NAMESPACE=opspilot
DEPLOYMENT=demo-api
APP_LABEL=demo-api
KUBE_CONTEXT=kind-opspilot

API_URL=http://localhost:4000
TELEMETRY_URL=http://localhost:9101

# Apply Kubernetes failure and/or POST a control-plane incident
APPLY_K8S=true
POST_INCIDENT=true

SEVERITY=SEV2
INCIDENT_TITLE="demo-api crash loop (simulation)"
INCIDENT_SUMMARY="Simulated pod failure on demo-api so OpsPilot can open an incident command center."
ERROR_RATE=12.5
AFFECTED_REPLICAS=1

# crashloop
CRASH_IMAGE=busybox:1.36
CRASH_COMMAND="echo opspilot-sim-crash; sleep 1; exit 1"

# imagepull
BAD_IMAGE=nginx:this-tag-does-not-exist-opspilot

# scale
SCALE_REPLICAS=0
HEALTHY_REPLICAS=2

# telemetry (demo-telemetry on :9101 — needs make obs-up after code change)
OK_DELTA=20
ERROR_DELTA=80

# restore
HEALTHY_IMAGE=nginx:1.27
